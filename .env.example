# Atur variable ini di dashboard Netlify (Project configuration → Environment variables).
# File .env hanya dipakai saat menjalankan aplikasi secara lokal.
NETLIFY_DATABASE_URL=
OWNER_TOKEN=replace-with-a-long-random-secret
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
